@startuml erd
title ERD — db_apotek (MyHealthGw)
hide circle
skinparam linetype ortho
skinparam class {
  BackgroundColor #F1FAEC
  BorderColor #1C6E7D
  HeaderBackgroundColor #8ADC64
}

entity "kategori" as kategori {
  * id : INT UNSIGNED <<PK, AI>>
  --
  * nama : VARCHAR(100) <<UNIQUE>>
  deskripsi : VARCHAR(255)
  ikon : VARCHAR(50)
  created_at : DATETIME
  updated_at : DATETIME
}

entity "produk" as produk {
  * id : INT UNSIGNED <<PK, AI>>
  --
  * kategori_id : INT UNSIGNED <<FK>>
  * nama : VARCHAR(150)
  * harga : DECIMAL(12,2)  (> 0)
  * stok : INT UNSIGNED  (>= 0)
  * deskripsi : TEXT
  gambar : VARCHAR(255)
  * golongan_obat : ENUM(...)
  * aturan_pakai : TEXT
  is_unggulan : TINYINT(1)
  created_at : DATETIME
  updated_at : DATETIME
}

entity "keranjang" as keranjang {
  * id : INT UNSIGNED <<PK, AI>>
  --
  * produk_id : INT UNSIGNED <<FK, UNIQUE>>
  * jumlah : INT UNSIGNED  (>= 1)
  created_at : DATETIME
}

entity "pesanan" as pesanan {
  * id : INT UNSIGNED <<PK, AI>>
  --
  * nomor_pesanan : VARCHAR(20) <<UNIQUE>>
  * nama_pemesan : VARCHAR(100)
  * no_hp : VARCHAR(15)
  * metode_pengambilan : ENUM('Ambil di Tempat','Diantar')
  alamat : TEXT
  catatan : TEXT
  * subtotal : DECIMAL(12,2)
  * biaya_layanan : DECIMAL(12,2)
  * ongkir : DECIMAL(12,2)
  * diskon : DECIMAL(12,2)
  * total : DECIMAL(12,2)
  * status : ENUM('Diproses','Selesai','Dibatalkan')
  * tanggal : DATETIME
}

entity "detail_pesanan" as detail {
  * id : INT UNSIGNED <<PK, AI>>
  --
  * pesanan_id : INT UNSIGNED <<FK>>
  produk_id : INT UNSIGNED <<FK, NULL>>
  * nama_produk : VARCHAR(150)  (snapshot)
  * harga_satuan : DECIMAL(12,2)  (snapshot)
  * jumlah : INT UNSIGNED
  * subtotal : DECIMAL(12,2)
}

kategori ||--o{ produk : "memiliki\n(ON DELETE RESTRICT)"
produk ||--o| keranjang : "dimasukkan ke\n(ON DELETE CASCADE)"
pesanan ||--|{ detail : "terdiri dari\n(ON DELETE CASCADE)"
produk |o--o{ detail : "dipesan dalam\n(ON DELETE SET NULL)"
@enduml
