<?xml version="1.0" encoding="utf-8"?>
<!-- Izinkan HTTP (cleartext) ke server XAMPP lokal, termasuk pada APK release. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
